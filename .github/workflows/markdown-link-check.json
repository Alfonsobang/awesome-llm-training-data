{
  "ignorePatterns": [],
  "replacementPatterns": [
    {
      "pattern": "^README.zh-CN.md$",
      "replacement": "./README.zh-CN.md"
    },
    {
      "pattern": "^README.md$",
      "replacement": "./README.md"
    },
    {
      "pattern": "^CONTRIBUTING.md$",
      "replacement": "./CONTRIBUTING.md"
    }
  ],
  "retryOn429": true,
  "retryCount": 3,
  "aliveStatusCodes": [200, 206, 403, 429]
}
